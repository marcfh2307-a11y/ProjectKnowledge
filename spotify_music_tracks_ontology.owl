<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#artistName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicContributor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">artist name</rdfs:label>
    <rdfs:comment xml:lang="en">The stage or band name of the artist.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#speechinessScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">speechiness score</rdfs:label>
    <rdfs:comment xml:lang="en">Presence of spoken words from 0.0 to 1.0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#DanceableTrack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:label xml:lang="en">Danceable Track</rdfs:label>
    <rdfs:comment xml:lang="en">A track with rhythm, tempo, and beat regularity highly suitable for dancing (danceability &gt;= 0.7).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#isArtistOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicContributor"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:label xml:lang="en">is artist of</rdfs:label>
    <rdfs:comment xml:lang="en">Inverse relation of hasArtist.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#hasArtist"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#JazzGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalGenre"/>
    <rdfs:label xml:lang="en">Jazz Genre</rdfs:label>
    <rdfs:comment xml:lang="en">Music tradition characterized by swing rhythms, complex chords, and improvisation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#DanceabilityFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature"/>
    <rdfs:label xml:lang="en">Danceability Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Measurement of how suitable a track is for dancing.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#EnergyFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature"/>
    <rdfs:label xml:lang="en">Energy Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Measurement of perceptual intensity and activity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#SingleRelease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicRelease"/>
    <rdfs:label xml:lang="en">Single Release</rdfs:label>
    <rdfs:comment xml:lang="en">A standalone release containing typically one or two promotional tracks.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Music Entity</rdfs:label>
    <rdfs:comment xml:lang="en">The root abstract concept for all music-related entities in the ontology.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#FolkGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalGenre"/>
    <rdfs:label xml:lang="en">Folk Genre</rdfs:label>
    <rdfs:comment xml:lang="en">Traditional and acoustic vernacular music.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AcousticnessFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature"/>
    <rdfs:label xml:lang="en">Acousticness Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Confidence value describing whether the track is acoustic.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#TimeSignatureFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#RhythmFeature"/>
    <rdfs:label xml:lang="en">Time Signature Feature</rdfs:label>
    <rdfs:comment xml:lang="en">The meter and rhythmic subdivision of bars in a track.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#tempoBpm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">tempo in BPM</rdfs:label>
    <rdfs:comment xml:lang="en">Estimated speed in beats per minute.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalKey">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicEntity"/>
    <rdfs:label xml:lang="en">Musical Key</rdfs:label>
    <rdfs:comment xml:lang="en">The pitch and tonic center of a musical track (e.g., C, C#, D).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#hasMusicalKey">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalKey"/>
    <rdfs:label xml:lang="en">has musical key</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a track to its estimated musical key.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#hasModality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalModality"/>
    <rdfs:label xml:lang="en">has modality</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a track to its musical mode (Major or Minor).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#isExplicit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="en">is explicit</rdfs:label>
    <rdfs:comment xml:lang="en">True if the track contains explicit lyrics, false otherwise.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N34916278fe1d4d40a4b43ac6c5e0a2f4">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="Nbc5bb0e80f014d1fa29d362d0f89a229"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicContributor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicEntity"/>
    <rdfs:label xml:lang="en">Music Contributor</rdfs:label>
    <rdfs:comment xml:lang="en">An artist, musician, or musical group responsible for performing or producing music.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#instrumentalnessScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">instrumentalness score</rdfs:label>
    <rdfs:comment xml:lang="en">Vocal absence prediction index from 0.0 to 1.0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#valenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">valence score</rdfs:label>
    <rdfs:comment xml:lang="en">Musical positiveness/happiness from 0.0 to 1.0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#acousticnessScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">acousticness score</rdfs:label>
    <rdfs:comment xml:lang="en">Acoustic confidence index from 0.0 to 1.0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MajorMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalModality"/>
    <rdfs:label xml:lang="en">Major Mode</rdfs:label>
    <rdfs:comment xml:lang="en">Major musical scale (mode 1), generally associated with bright or happy moods.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MinorMode"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb2d47f4db05545029da30103a8bae6e2">
    <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#HipHopGenre"/>
    <rdf:rest rdf:nodeID="N4d28e45b9eaa4e6e961497a9877c81a3"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#ClassicalGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalGenre"/>
    <rdfs:label xml:lang="en">Classical Genre</rdfs:label>
    <rdfs:comment xml:lang="en">Western art music tradition including orchestral, chamber, and choral works.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#InstrumentalTrack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:label xml:lang="en">Instrumental Track</rdfs:label>
    <rdfs:comment xml:lang="en">A track that contains no vocal components (instrumentalness &gt;= 0.5).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#danceabilityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">danceability score</rdfs:label>
    <rdfs:comment xml:lang="en">Danceability index from 0.0 to 1.0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd712ed09dedb4aa1b3bb53f9b1889126">
    <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#SingleRelease"/>
