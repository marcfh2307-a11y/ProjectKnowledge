  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AlbumRelease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicRelease"/>
    <rdfs:label xml:lang="en">Album Release</rdfs:label>
    <rdfs:comment xml:lang="en">A full-length studio or live musical release consisting of multiple tracks.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4d28e45b9eaa4e6e961497a9877c81a3">
    <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#ClassicalGenre"/>
    <rdf:rest rdf:nodeID="N4cf1c02b5a3448b6a9719f8afde0c6bf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#LatinGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalGenre"/>
    <rdfs:label xml:lang="en">Latin Genre</rdfs:label>
    <rdfs:comment xml:lang="en">Music originating from Latin America and the Iberian Peninsula, such as reggaeton, salsa, and bachata.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AmbientGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalGenre"/>
    <rdfs:label xml:lang="en">Ambient Genre</rdfs:label>
    <rdfs:comment xml:lang="en">A style of gentle, mostly electronic instrumental music focusing on timbre and texture.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#livenessScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">liveness score</rdfs:label>
    <rdfs:comment xml:lang="en">Audience presence index from 0.0 to 1.0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#trackTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">track title</rdfs:label>
    <rdfs:comment xml:lang="en">The official title of the track.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#LivenessFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature"/>
    <rdfs:label xml:lang="en">Liveness Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Detects audience presence in the audio signal.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#SpeechinessFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature"/>
    <rdfs:label xml:lang="en">Speechiness Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Presence of spoken words in the track.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#ValenceFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature"/>
    <rdfs:label xml:lang="en">Valence Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Measurement of musical positiveness conveyed by a track.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AcousticTrack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:label xml:lang="en">Acoustic Track</rdfs:label>
    <rdfs:comment xml:lang="en">A track produced primarily using natural, non-electric instruments (high acousticness &gt;= 0.5).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3a3bc70a27ca4e93859ec13423373991">
    <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#CompilationRelease"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#VocalTrack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:label xml:lang="en">Vocal Track</rdfs:label>
    <rdfs:comment xml:lang="en">A track that features prominent singing or vocal performances (instrumentalness &lt; 0.5).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#belongsToRelease">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicRelease"/>
    <rdfs:label xml:lang="en">belongs to release</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an audio track to the album, single, or EP on which it was published.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#energyScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label xml:lang="en">energy score</rdfs:label>
    <rdfs:comment xml:lang="en">Energy index from 0.0 to 1.0.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#LoudnessFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature"/>
    <rdfs:label xml:lang="en">Loudness Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Overall loudness in decibels (dB).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N3ff2cf9c6e684b258662349114265514">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
    <owl:members rdf:nodeID="N64af3eec46244a3a98eb3ddfd67327ab"/>
  </rdf:Description>
