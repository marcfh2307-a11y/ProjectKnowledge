  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#PerceptualFeature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioFeature"/>
    <rdfs:label xml:lang="en">Perceptual Feature</rdfs:label>
    <rdfs:comment xml:lang="en">Psychoacoustic features describing human sensory perception of music.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N4cf1c02b5a3448b6a9719f8afde0c6bf">
    <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#JazzGenre"/>
