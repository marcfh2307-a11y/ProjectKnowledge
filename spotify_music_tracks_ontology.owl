  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#hasGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicalGenre"/>
    <rdfs:label xml:lang="en">has genre</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a track or release to its associated musical genre.</rdfs:comment>
