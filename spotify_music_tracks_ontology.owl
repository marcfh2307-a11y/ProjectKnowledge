  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#popularityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label xml:lang="en">popularity score</rdfs:label>
    <rdfs:comment xml:lang="en">Spotify popularity score between 0 and 100.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#hasArtist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#AudioTrack"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2026/10/spotify-music-tracks#MusicContributor"/>
    <rdfs:label xml:lang="en">has artist</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an audio track to its performing artist or group.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N221af8ddcc1942c692de097f7d134f46">
